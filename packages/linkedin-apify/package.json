{
  "name": "@noelle/linkedin-apify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Read-only LinkedIn posts and comments through Apify.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
