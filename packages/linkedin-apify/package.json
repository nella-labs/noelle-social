    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@noelle/runtime": "workspace:*"
  }
}
