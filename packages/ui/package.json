{
  "name": "@noelle/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Noelle Constellation design system — shared tokens, Tailwind preset, and components.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "tailwind-preset.cjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tailwind-preset": {
      "require": "./tailwind-preset.cjs",
      "default": "./tailwind-preset.cjs"
    },
    "./globals.css": "./src/globals.css",
    "./fonts.css": "./src/fonts.css",
    "./tokens": {
      "types": "./src/tokens.ts",
      "import": "./src/tokens.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'noop — @noelle/ui has no lint step yet'"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
