{
  "name": "@noelle/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "GCP Secret Manager client wrapper used by every noelle-vm-0 service (apps/x-intern workers and apps/api-vm). TTL-cached, per-org + legacy fallback name resolution, narrow SecretAccessError taxonomy.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "@noelle/process": "workspace:*",
    "google-auth-library": "^10.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
