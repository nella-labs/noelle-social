# Supabase (NOELLE project: hoyxsfupnjyonwqdjvra)
NEXT_PUBLIC_SUPABASE_URL=https://hoyxsfupnjyonwqdjvra.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hono service at api.trynoelle.com (apps/api-vm via Cloudflare tunnel).
# Local dev: http://localhost:18791
NOELLE_API_BASE_URL=https://api.trynoelle.com

# Legacy / dev fallback for the /onboarding invite gate. The primary path is
# now DB-backed: admins mint invitations from /app/<slug>/admin/invitations
# (noelle.alpha_invitations). Codes listed here still validate, so it's handy
# for local dev where you don't want to seed the table. Leave empty in prod.
# Comma-separated list of valid codes.
NOELLE_ALPHA_INVITE_CODES=

# HMAC secret for the `noelle_email_verified` cookie that proves a session
# already passed the /auth/gate allowlist check. Must be a stable random
# string in production (rotate by changing this — all current sessions
# re-gate on next request). Local dev falls back to a fixed dev literal;
# production REQUIRES this (the request fails closed if unset). Never the
# anon key.
NOELLE_GATE_COOKIE_SECRET=

# HMAC secret for the `noelle_invite_redeemed` cookie set when a user submits a
# valid alpha invite code (/onboarding). Same contract as the gate secret:
# local dev falls back to a fixed dev literal; production REQUIRES this (invite
# redemption fails closed if unset). Never the anon key.
NOELLE_INVITE_COOKIE_SECRET=

# Cloud SQL data plane (noelle.* reads/writes).
#
# Production (Vercel) uses Workload Identity Federation: Vercel auto-injects
# VERCEL_OIDC_TOKEN per invocation; google-auth-library exchanges it for an
# impersonated SA access token; @google-cloud/cloud-sql-connector opens an
# IAM-authed tunnel; postgres.js connects over that with the SA email as
# the Postgres user. No password lives in Vercel env vars.
NOELLE_GCP_PROJECT_NUMBER=1068570846548
NOELLE_GCP_POOL_ID=vercel-pool
NOELLE_GCP_PROVIDER_ID=vercel-oidc
NOELLE_GCP_SA_EMAIL=vercel-noelle-app@noelle-agents.iam.gserviceaccount.com
NOELLE_CLOUDSQL_INSTANCE=noelle-agents:us-east1:noelle-db

# Local-dev fallback only. If VERCEL_OIDC_TOKEN is absent (i.e. `pnpm
# dev`), db.ts uses this password-over-public-IP URL. Leave empty in
# Vercel project envs.
NOELLE_DATABASE_URL=

# ─── Email — Listmonk (marketing + transactional via SES) ──────────────────
# Listmonk runs on its own GCP VM (see docs/email-infrastructure.md). The
# admin /broadcasts page in this dashboard reads lists + recent campaigns
# and creates new campaigns through this admin API.
LISTMONK_URL=https://listmonk.trynoelle.com
LISTMONK_USER=
LISTMONK_PASSWORD=
LISTMONK_FROM_EMAIL=Noelle <news@mail.trynoelle.com>

# ─── Email — SES status reads (optional) ───────────────────────────────────
# Used by the /admin/email page to render live sending quota + sandbox/prod
# status. Requires an IAM user with ses:GetAccount + ses:GetSendQuota (a
# separate user from the SMTP one Listmonk uses — never reuse SMTP creds
# for API). Leave blank to fall back to a static "AWS console" link.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
