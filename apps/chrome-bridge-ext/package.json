{
  "name": "@noelle/chrome-bridge-ext",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "Claude's hands on Chrome — MV3 extension that executes ChromeOps from the Chrome Bridge in the operator's own browser.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node ./scripts/swap-dist-unpacked.mjs",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@noelle/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wxt": "^0.19.0"
  }
}
