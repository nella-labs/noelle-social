{
  "name": "@noelle/mcp",
  "version": "0.0.1-alpha.0",
  "description": "Operate Noelle organizations, agents, approvals and content through an MCP client.",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "noelle-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@noelle/runtime": "workspace:*",
    "jose": "^5.9.6",
    "postgres": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
